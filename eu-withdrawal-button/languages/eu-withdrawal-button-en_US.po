#: includes/class-euwb-admin.php:372
#: includes/emails/class-euwb-email-customer-intent.php:12
msgid "Richiesta di recesso ricevuta – Ordine #{order_number}"
msgstr "Withdrawal request received – Order #{order_number}"

#: includes/class-euwb-admin.php:373
#: includes/emails/templates/euwb-customer-intent-plain.php:5
#: includes/emails/templates/euwb-customer-intent.php:5
msgid ""
"Gentile {customer_name},\n"
"\n"
"abbiamo ricevuto la tua richiesta di recesso per l'ordine #{order_number} "
"del {order_date}.\n"
"\n"
"La richiesta è attualmente in fase di elaborazione. Riceverai un'email di "
"conferma non appena sarà processata.\n"
"\n"
"Ai sensi dell'Art. 11a della Direttiva UE 2023/2673."
msgstr ""
"Dear {customer_name},\n"
"\n"
"We have received your cancellation request for order #{order_number} of "
"{order_date}.\n"
"\n"
"The request is currently being processed. You will receive a confirmation "
"email as soon as it is processed.\n"
"\n"
"Pursuant to Art. 11a of EU Directive 2023/2673."

#: includes/class-euwb-admin.php:374
#: includes/emails/class-euwb-email-customer-confirmation.php:12
msgid "Conferma di recesso – Ordine #{order_number}"
msgstr "Withdrawal Confirmation – Order #{order_number}"

#: includes/class-euwb-admin.php:375
#: includes/emails/templates/euwb-customer-confirmation-plain.php:5
#: includes/emails/templates/euwb-customer-confirmation.php:5
msgid ""
"Gentile {customer_name},\n"
"\n"
"il tuo recesso per l'ordine #{order_number} del {order_date} è stato "
"confermato.\n"
"\n"
"Il rimborso sarà elaborato nei prossimi 14 giorni lavorativi con lo stesso "
"metodo di pagamento utilizzato all'acquisto.\n"
"\n"
"Ai sensi dell'Art. 11a della Direttiva UE 2023/2673."
msgstr ""
"Dear {customer_name},\n"
"\n"
"Your cancellation for order #{order_number} of {order_date} has been "
"confirmed.\n"
"\n"
"The refund will be processed within the next 14 business days using the same "
"payment method used for the purchase.\n"
"\n"
"Pursuant to Art. 11a of EU Directive 2023/2673."

