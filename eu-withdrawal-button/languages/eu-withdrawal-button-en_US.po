#: includes/class-euwb-admin.php:421 includes/class-euwb-frontend.php:126
msgid ""
"Hai il diritto di recedere dal presente contratto entro {withdrawal_window} "
"giorni senza fornire alcuna motivazione. Il periodo di recesso scade tra "
"{days_left} giorni."
msgstr ""
"You have the right to withdraw from this contract within {withdrawal_window} "
"days without giving any reason. The withdrawal period expires in {days_left} "
"days."

#: includes/class-euwb-admin.php:422 includes/class-euwb-frontend.php:43
